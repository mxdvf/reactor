direction: right

vars: {
  d2-legend: {
    b: UserProvided {
      shape: rectangle
      style.fill: "#f4a261"
    }
  }
}

classes: {
  state: {
      shape: page
      style.fill: "#f4a261"
  }
  in_edge: {
    style: {
      stroke: "green"
    }
  }
  out_edge: {
    style: {
      stroke: "red"
    }
  }
  rw_edge: {
    style: {
      stroke: "purple"
      stroke-dash: 3
    }
  }
}

# Parents
parent1: "Parent Actor1"
parent2: "Parent Actor2"

# Recv to Processor
recv: "Receiver"
gen: "Generators"
gen.style.fill: "#f4a261"

proc_q: "Process Q"
proc_q.shape: queue

recv.state: "Locked RState"
recv.state.class: state
recv.tasks
recv.tasks.sub1: "Recv Sub Task1"
recv.tasks.sub2: "Recv Sub Task2"

parent1 -> recv.tasks.sub1 {
  class: in_edge
}
parent2 -> recv.tasks.sub2{
  class: in_edge
}

recv.tasks.sub1 <-> recv.state {
  class: rw_edge
}
recv.tasks.sub2 <-> recv.state {
  class: rw_edge
}

recv.tasks.sub1 -> proc_q{
  class: in_edge
}
recv.tasks.sub2 -> proc_q{
  class: in_edge
}
gen -> proc_q{
  class: in_edge
}

# Processor to Send
proc: "Processor"
proc.state: "State"
proc.state.class: state
proc.fn: "f(I) -> O"
proc.fn.shape: circle
proc_q -> proc.fn {
  class: in_edge
}
proc.fn -> send_q {
  class: out_edge
}
proc.fn <-> proc.state {
  class: rw_edge 
}
proc.fn.style.fill: "#f4a261"

send_q: "Send Q"
send_q.shape: queue

# Send to Actor
sender: "Sender"
sender.state: "Sender State"
sender.state.class: state
sender.router: "Router"
sender.router.style.fill: "#f4a261"
send_q -> sender.router {
  class: out_edge
}
sender.router <-> sender.state{
  class: rw_edge
}

sender.send_buff1: "SendBuff1"
sender.send_buff2: "SendBuff2"
sender.send_buff1.shape: queue
sender.send_buff2.shape: queue
sender.router -> sender.send_buff1 {
  class: out_edge
}
sender.router -> sender.send_buff2{
  class: out_edge
}
sender.sub1: "Sub Sender1"
sender.sub2: "Sub Sender2"
sender.send_buff1 -> sender.sub1{
  class: out_edge
}
sender.send_buff2 -> sender.sub2{
  class: out_edge
}

sender.sub1 -> Child1{
  class: out_edge
}
sender.sub2 -> Child2{
  class: out_edge
}
